<!doctype html>
<html lang="es"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>XAUUSD Analyzer 3.0</title><style>
:root{color-scheme:dark}body{margin:0;background:#0b1220;color:#edf2fa;font:15px system-ui,Arial}main{max-width:850px;margin:auto;padding:18px}h1{color:#facc15;margin-bottom:4px}.muted{color:#a9b6ca}.panel{background:#18243a;border:1px solid #293b56;border-radius:14px;padding:16px;margin:14px 0}input,button{box-sizing:border-box;width:100%;padding:13px;border-radius:9px;border:0;font:inherit}input{background:#fff;color:#111;margin:8px 0}button{background:#facc15;color:#111827;font-weight:750}button:disabled{opacity:.6}.warn{color:#ffd18c}.good{color:#92e6bc}.bad{color:#ffaaa9}.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}.small{font-size:12px}.stats{line-height:1.85}canvas{width:100%;height:250px;display:block;background:#101b2c;border-radius:9px}.hidden{display:none}@media(max-width:550px){.grid{grid-template-columns:1fr}}
</style></head><body><main><h1>🥇 XAUUSD Analyzer 3.0</h1><p class="muted">Estudio técnico educativo · M5 + M15 · Sin operaciones automáticas</p><section class="panel"><label for="api">Clave API Twelve Data (solo durante esta sesión)</label><input id="api" type="password" autocomplete="off" placeholder="Pega aquí tu clave"><button id="go">Analizar M5 y M15</button><p class="muted small">La clave no se guarda ni se incluye en GitHub. La consulta se realiza desde este navegador directamente a Twelve Data; para una publicación con clave protegida se necesita un servidor intermediario.</p></section><section class="panel"><strong>Estado de los datos</strong><p id="status" class="muted" aria-live="polite">Sin consultar.</p><p id="summary" class="warn"></p></section><div class="grid"><section class="panel"><h2>M5 · 5 minutos</h2><div id="m5stats" class="stats">Esperando datos…</div><canvas id="m5chart" width="680" height="300" aria-label="Velas de cinco minutos"></canvas></section><section class="panel"><h2>M15 · 15 minutos</h2><div id="m15stats" class="stats">Esperando datos…</div><canvas id="m15chart" width="680" height="300" aria-label="Velas de quince minutos"></canvas></section></div><p class="muted small">Fuente: Twelve Data. La disponibilidad, horarios, zona horaria y símbolo dependen del proveedor y del plan. No sustituye información de mercado verificada. Nunca uses una lectura con datos dudosos para tomar decisiones financieras.</p></main><script>
'use strict';
const el=id=>document.getElementById(id);
function ema(values,n){const k=2/(n+1);let x=values[0];return values.map(v=>x=v*k+x*(1-k));}
function rsi(values,n=14){if(values.length<=n)return NaN;let gain=0,loss=0;for(let i=1;i<=n;i++){let d=values[i]-values[i-1];gain+=Math.max(d,0);loss+=Math.max(-d,0);}gain/=n;loss/=n;for(let i=n+1;i<values.length;i++){let d=values[i]-values[i-1];gain=(gain*(n-1)+Math.max(d,0))/n;loss=(loss*(n-1)+Math.max(-d,0))/n;}return loss===0?(gain===0?50:100):100-100/(1+gain/loss);}
function parseUTC(s){if(!/^\d{4}-\d\d-\d\d[ T]\d\d:\d\d(:\d\d)?$/.test(s))return NaN;return Date.parse(s.replace(' ','T')+'Z');}
function draw(id,c){const canvas=el(id),ctx=canvas.getContext('2d');const w=canvas.width,h=canvas.height;ctx.clearRect(0,0,w,h);if(!c.length)return;const v=c.slice(-45),lo=Math.min(...v.map(x=>x.low)),hi=Math.max(...v.map(x=>x.high));const range=hi-lo||1;const y=p=>25+(hi-p)/range*(h-50);ctx.strokeStyle='#31445d';ctx.lineWidth=1;for(let i=0;i<5;i++){let yy=25+i*(h-50)/4;ctx.beginPath();ctx.moveTo(38,yy);ctx.lineTo(w-10,yy);ctx.stroke();ctx.fillStyle='#a9b6ca';ctx.font='12px system-ui';ctx.fillText((hi-i*range/4).toFixed(2),2,yy-4);}const step=(w-58)/v.length;v.forEach((x,i)=>{let xx=42+(i+.5)*step;ctx.strokeStyle=ctx.fillStyle=x.close>=x.open?'#61d9a0':'#f18a8a';ctx.beginPath();ctx.moveTo(xx,y(x.high));ctx.lineTo(xx,y(x.low));ctx.stroke();let top=Math.min(y(x.open),y(x.close)),height=Math.max(2,Math.abs(y(x.open)-y(x.close)));ctx.fillRect(xx-step*.32,top,Math.max(2,step*.64),height);});}
function analyze(d,interval){if(d.status==='error'||!Array.isArray(d.values))throw Error(d.message||'No hay velas para '+interval);const timezone=(d.meta&&d.meta.exchange_timezone)||'';const rows=d.values.map(x=>({datetime:x.datetime,open:+x.open,high:+x.high,low:+x.low,close:+x.close})).reverse();if(rows.length<55||rows.some(x=>![x.open,x.high,x.low,x.close].every(Number.isFinite)))throw Error('Datos insuficientes o inválidos en '+interval);const close=rows.map(x=>x.close),e20=ema(close,20).at(-1),e50=ema(close,50).at(-1),r=rsi(close),last=rows.at(-1);const ts=timezone==='UTC'||timezone==='Etc/UTC'?parseUTC(last.datetime):NaN;const age=Number.isFinite(ts)?Date.now()-ts:NaN;const issues=[];if(!Number.isFinite(ts))issues.push('Zona horaria de la fuente no confirmada ('+(timezone||'no indicada')+')');else{if(age< -5*60*1000)issues.push('La última vela tiene una fecha futura');if(age>60*60*1000)issues.push('Última vela con más de 60 minutos de antigüedad');}if(rows.some((x,i)=>x.low>Math.min(x.open,x.close)||x.high<Math.max(x.open,x.close)||x.low>x.high))issues.push('Velas con valores incoherentes');const trend=e20>e50&&last.close>e20?'Sesgo alcista':e20<e50&&last.close<e20?'Sesgo bajista':'Sin tendencia clara';return {rows,last,e20,e50,r,trend,issues,timezone};}
function show(id,a){el(id+'stats').innerHTML='Precio: <b>'+a.last.close.toFixed(2)+'</b><br>EMA 20: '+a.e20.toFixed(2)+'<br>EMA 50: '+a.e50.toFixed(2)+'<br>RSI 14: '+a.r.toFixed(2)+'<br>Lectura: '+a.trend+'<br><span class="small muted">Última vela: '+a.last.datetime+' ('+(a.timezone||'zona sin confirmar')+')</span>';draw(id+'chart',a.rows);}
async function fetchSeries(key,interval){const params=new URLSearchParams({symbol:'XAU/USD',interval,outputsize:'120',apikey:key});const response=await fetch('https://api.twelvedata.com/time_series?'+params);if(!response.ok)throw Error('HTTP '+response.status);return response.json();}
el('go').addEventListener('click',async()=>{const key=el('api').value.trim();if(!key){el('status').textContent='Introduce tu clave API.';return;}el('go').disabled=true;el('status').textContent='Consultando las dos temporalidades…';el('summary').textContent='';try{const [d5,d15]=await Promise.all([fetchSeries(key,'5min'),fetchSeries(key,'15min')]);const a=analyze(d5,'M5'),b=analyze(d15,'M15');show('m5',a);show('m15',b);const issues=[...a.issues.map(x=>'M5: '+x),...b.issues.map(x=>'M15: '+x)];el('status').textContent=issues.length?'Revisión necesaria: '+issues.join(' · '):'Fechas verificadas como UTC y sin alertas básicas de antigüedad.';el('summary').textContent=issues.length?'No interpretar estas lecturas como actuales hasta verificar la fuente.':a.trend===b.trend&&a.trend!=='Sin tendencia clara'?'Ambas temporalidades muestran '+a.trend.toLowerCase()+'. Esto no confirma una operación.':'M5 y M15 no ofrecen una lectura conjunta clara.';}catch(err){el('status').textContent='No se pudo completar el análisis: '+err.message;el('summary').textContent='Comprueba la cobertura XAU/USD de tu plan, la cuota de API y la conexión.';}finally{el('go').disabled=false;}});
</script></body></html>
